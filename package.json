{
  "name": "spool-knowledge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,api -c blue,magenta \"npm:dev:app\" \"npm:dev:api\"",
    "dev:app": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "migrate:captures": "node --env-file-if-exists=.env scripts/migrate-captures.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/functions": "^3.9.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vercel": "^59.5.0",
    "vite": "^6.0.1"
  }
}
